{"count": 28689, "next": "https://api.acmi.net.au/creators/?page=548", "previous": "https://api.acmi.net.au/creators/?page=546", "results": [{"id": 80115, "name": "Roger Daltrey", "roles_in_work": [{"id": 2171412, "title": "McVicar", "work_id": 93055, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "Roger Harry Daltrey", "date_of_birth": "1944-03-01", "date_of_death": "", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 1, "name": "English", "slug": "english"}], "places_of_operation": [{"id": 10, "name": "United Kingdom", "slug": "united-kingdom"}], "biography": "Roger Harry Daltrey  (born 1 March 1944) is an English singer, musician and actor. He is a co-founder and the lead singer of the rock band the Who.Daltrey's hit songs with the Who include \"My Generation\", \"Pinball Wizard\", \"Won't Get Fooled Again\", \"Baba O'Riley\" and \"You Better You Bet\". He began his solo career in 1973, while still a member of the Who. Since then he has released ten solo studio albums, five compilation albums, and one live album. His solo hits include \"Giving It All Away\", \"Walking the Dog\", \"Written on the Wind\", \"Free Me\", \"Without Your Love\" and \"Under a Raging Moon\".\nThe Who are considered one of the most influential rock bands of the 20th century and have sold over 100 million records worldwide. As a member of the band, Daltrey received a Lifetime achievement award from the British Phonographic Industry in 1988, and from the Grammy Foundation in 2001. He was inducted into the Rock and Roll Hall of Fame in 1990, and the UK Music Hall of Fame in 2005. He and Pete Townshend received Kennedy Center Honors in 2008 and The George and Ira Gershwin Award for Lifetime Musical Achievement at UCLA on 21 May 2016. Daltrey has also been an actor and film producer, with roles in films, theatre, and television. Planet Rock listeners voted him rock's fifth-greatest voice in 2009, and he was ranked number 61 on Rolling Stone's list of the 100 greatest singers of all time in 2010.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T16:53:59.385358+10:00", "external_links": [{"id": 3013, "uri": "https://en.wikipedia.org/wiki/Roger_Daltrey"}], "uuid": "01b404e9-6641-4c29-b471-b5615e0755b3", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "28036", "external_references": [{"id": 12794, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q311672"}, {"id": 12795, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "55251960"}, {"id": 12796, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n84221838"}, {"id": 12797, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n84221838"}], "date_modified": "2023-09-06T00:51:28.555832+10:00"}, {"id": 80114, "name": "David Belling", "roles_in_work": [{"id": 2264967, "title": "Scum (D)", "work_id": 93054, "role": "producer", "role_id": 1089, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T17:35:05.236006+10:00", "external_links": [], "uuid": "fd0a63a9-2d1b-49b6-a9c7-119993bacb2d", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "17502", "external_references": [{"id": 40717, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q121034275"}], "date_modified": "2023-09-05T18:54:42.403549+10:00"}, {"id": 80113, "name": "Strong Arm Films", "roles_in_work": [{"id": 2135587, "title": "Cheek to cheek", "work_id": 93041, "role": "production company", "role_id": 941, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T13:28:57.149330+10:00", "external_links": [], "u