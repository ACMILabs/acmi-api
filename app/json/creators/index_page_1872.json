tifier": "Q121357926"}], "date_modified": "2023-09-05T23:28:59.239374+10:00"}, {"id": 23446, "name": "Michael Hampe", "roles_in_work": [{"id": 2138295, "title": "Cinderella = La Cenerentola", "work_id": 81204, "role": "co-director", "role_id": 959, "is_primary": true}, {"id": 2095761, "title": "Andrea Chenier", "work_id": 95425, "role": "producer", "role_id": 1089, "is_primary": true}], "also_known_as": "", "date_of_birth": "1935-06-03", "date_of_death": "2022-11-18", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 5, "name": "German", "slug": "german"}], "places_of_operation": [{"id": 18, "name": "Germany", "slug": "germany"}], "biography": "Michael Hampe (3 June 1935 – 18 November 2022) was a German theatre and opera director, general manager (Intendant) and actor. He developed from acting and directing plays at German and Swiss theatres including the Bern Theatre, to focus on directing opera and managing opera houses, first at the Mannheim National Theatre, then the Cologne Opera from 1975. He was professor at the Hochschule für Musik und Tanz Köln since 1977. Hampe was influential for both the Salzburg Festival and, after the reunification of Germany, the Dresden Music Festival for which he commissioned and directed world premieres. He directed at international opera houses and festivals, including productions recorded for television, film and DVD.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T23:05:34.290813+10:00", "external_links": [{"id": 6031, "uri": "https://en.wikipedia.org/wiki/Michael_Hampe"}], "uuid": "eedf3910-1017-4524-be18-a0eb7e3ffe2d", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "25087", "external_references": [{"id": 37206, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q1927676"}, {"id": 55262, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "88135898"}, {"id": 55263, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_i