": "australia"}], "biography": "Robert Scott Hicks (born 4 March 1953), known as Scott, is an Australian film director, producer and screenwriter. He is best known as the screenwriter and director of Shine, the biopic of pianist David Helfgott. For this, Hicks was nominated for two Academy Awards. Other movies he has directed include the film adaptations of Stephen King's Hearts in Atlantis and Nicholas Sparks' The Lucky One.\n\n", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T17:01:17.114451+10:00", "external_links": [{"id": 5132, "uri": "https://en.wikipedia.org/wiki/Scott_Hicks_(director)"}], "uuid": "ce5acdd9-943a-456f-9812-c07d8c5a32ac", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "28626", "external_references": [{"id": 25330, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q951522"}, {"id": 31438, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "29733332"}, {"id": 31439, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no97024669"}, {"id": 31440, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no97024669"}], "date_modified": "2023-09-06T01:08:26.907399+10:00"}, {"id": 19839, "name": "Warren Johnson", "roles_in_work": [{"id": 2074622, "title": "A Special time", "work_id": 76594, "role": "producer", "role_id": 1089, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T11:39:05.108591+10:00", "external_links": [], "uuid": "c1331baa-f274-4d80-bb83-5aeabf59e5ac", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "30288", "external_references": [{"id": 36632, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q121086206"}], "date_modified": "2023-09-06T02:12:04.834316+10:00"}, {"id": 19838, "name": "Borge Ring", "roles_i