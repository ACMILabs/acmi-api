{"count": 26427, "next": "https://api.acmi.net.au/creators/?page=402", "previous": "https://api.acmi.net.au/creators/?page=400", "results": [{"id": 81406, "name": "Anton M Leader", "roles_in_work": [{"id": 2136617, "title": "Children of the damned", "work_id": 95630, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1913-12-23", "date_of_death": "1988-07-01", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Anton Leader (December 23, 1913 – July 1, 1988) was an American radio and television director. He was born in Boston, Massachusetts, on December 23, 1913. He directed radio dramas in New York in the 1940s and moved to Los Angeles in 1948. Subsequently, he worked as a free-lancer for Universal Studios and Columbia Pictures, among others. From the middle 1950s to the middle 1970s he directed many episodes of the popular television series of that era. Known as \"Tony\" to friends and colleagues, his screen credits alternated between \"Tony Leader\" and the more formal \"Anton M. Leader.\" He died in Los Angeles, California, on July 1, 1988.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T14:05:02.565434+10:00", "external_links": [{"id": 1669, "uri": "https://en.wikipedia.org/wiki/Anton_Leader"}], "uuid": "6e4cc075-7f6c-4c9b-9318-ff1c5c434358", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "15421", "external_references": [{"id": 7278, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q591439"}, {"id": 7279, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "44528151"}, {"id": 7280, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no91005673"}, {"id": 7281, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no91005673"}], "date_modified": "2023-09