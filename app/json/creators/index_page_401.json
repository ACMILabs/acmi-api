ography_author": "Wikidata", "date_of_biography": "2023-08-01T16:56:23.220501+10:00", "external_links": [{"id": 5086, "uri": "https://en.wikipedia.org/wiki/Roy_Rowland_(film_director)"}], "uuid": "1a59d3bc-7908-4c8c-a1ca-1f9bff0667ce", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "28315", "external_references": [{"id": 26623, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q541764"}, {"id": 31329, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "87240733"}, {"id": 31330, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "viaf-87240733"}], "date_modified": "2023-09-06T00:57:31.546094+10:00"}, {"id": 81400, "name": "Mary Wickes", "roles_in_work": [{"id": 2476062, "title": "The Man who came to dinner", "work_id": 95615, "role": "cast", "role_id": 33, "is_primary": false}], "also_known_as": "", "date_of_birth": "1910-06-13", "date_of_death": "1995-10-22", "genders": [{"id": 5, "name": "Female", "slug": "female"}], "languages": [], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Mary Wickes (born Mary Isabella Wickenhauser; June 13, 1910 – October 22, 1995) was an American actress. She often played supporting roles as prim, professional women, secretaries, nurses, nuns, therapists, teachers and housekeepers, who made sarcastic quips when the leading characters fell short of her high standards.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T22:52:37.525971+10:00", "external_links": [{"id": 4644, "uri": "https://en.wikipedia.org/wiki/Mary_Wickes"}], "uuid": "a03666eb-dd3b-4173-86db-021735e2494b", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "38503", "external_references": [{"id": 25314, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q263241"}, {"id": 30189, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "14962451"}, {"id": 30190, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n80143865"}, {"id": 30191, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n80143865"}], "date_modified": "2023-09-05T22:52:39.700195+10:00"}, {"id": 81399, "name": "Billy Burke", "roles_in_work": [{"id": 2476061, "title": "The Man who came to dinner", "work_id": 95615, "role": "cast", "role_id": 33, "is_primary": false}], "also_known_as": "", "date_of_birth": "1884-08-07", "date_of_death": "1970-05-14", "genders": [{"id": 5, "name": "Female", "slug": "female"}], "languages": [{"id": 1, "name": "English", "slug": "english"}], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Mary William Ethelbert Appleton Burke (August 7, 1884 – May 14, 1970) was an American actress who was famous on Broadway and radio, and in silent and sound films. She is best known to modern audiences as Glinda the Good Witch of the North in the Metro-Goldwyn-Mayer movie musical The Wizard of Oz (1939).\nBurke was nominated for the Academy Award for Best Supporting Actress for her performance as Emily Kilbourne in Merrily We Live (1938). She is also remembered for her appearances in the Topper film series. Her unmistakable high-pitched, quivering and aristocratic voice, made her a frequent choice to play dimwitted or spoiled society types.\nShe was married to Broadway producer and impresario Florenz Ziegfeld Jr. from 1914 until his death in 1932.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T18:05:17.325635+10:00", "external_links": [{"id": 5711, "uri": "https://en.wikipedia.org/wiki/Billie_Burke"}], "uuid": "0e9563fd-b391-4dbb-9854-27df1a6ca394", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "32298", "external_references": [{"id": 36373, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q235639"}, {"id": 54086, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "44487813"}, {"id": 54087, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n85151807"}, {"id": 54088, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n85151807"}], "date_modified": "2023-09-05T18:05:22.242710+10:00"}, {"id": 81398, "name": "Ann Sheridan", "roles_in_work": [{"id": 2476059, "title": "The Man who came to dinner", "work_id": 95615, "role": "cast", "role_id": 33, "is_primary": false}], "also_known_as": "", "date_of_birth": "1915-02-21", "date_of_death": "1967-01-21", "genders": [{"id": 5, "name": "Female", "slug": "female"}], "languages": [{"id": 1, "name": "English", "slug": "english"}], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Clara Lou \"Ann\" Sheridan (February 21, 1915 – January 21, 1967) was an American actress and singer. She is best known for her roles in the films San Quentin (1937) with Humphrey Bogart, Angels with Dirty Faces (1938) with James Cagney and Bogart, They Drive by Night (1940) with George Raft and Bogart, City for Conquest (1940) with Cagney and Elia Kazan, The Man Who Came to Dinner (1942) with Bette Davis, Kings Row (1942) with Ronald Reagan, Nora Prentiss (1947), and I Was a Male War Bride (1949) with Cary Grant.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T17:39:04.086566+10:00", "external_links": [{"id": 3562, "uri": "https://en.wikipedia.org/wiki/Ann_Sheridan"}], "uuid": "3b651342-f0f9-4d0d-9b06-b42ce4a8ef6f", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "38502", "external_references": [{"id": 25225, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q233848"}, {"id": 27291, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "29719378"}, {"id": 27292, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n85199186"}, {"id": 27293, "source": {"name": "WorldCat", 