sm.\nPialat's films are said to have dispensed with mannerisms, and his everyday stories tell the bittersweet nature of the French petty bourgeoisie. This earned him the disregard of some critics, but also enduring popularity, with films characterized by a psychological narrative style, often set outside the metropolises.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T16:10:23.004551+10:00", "external_links": [{"id": 4659, "uri": "https://en.wikipedia.org/wiki/Maurice_Pialat"}], "uuid": "7e6f2a84-cf81-4464-82b7-8ee11645d26e", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "24842", "external_references": [{"id": 26346, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q503898"}, {"id": 30231, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "29592260"}, {"id": 30232, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n84155315"}, {"id": 30233, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n84155315"}], "date_modified": "2023-09-13T12:31:19.400936+10:00"}]}