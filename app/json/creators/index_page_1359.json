ning", "roles_in_work": [{"id": 1809437, "title": "Rabid [DVD] (D)", "work_id": 94450, "role": "producer", "role_id": 1089, "is_primary": true}], "also_known_as": "", "date_of_birth": "1927-04-27", "date_of_death": "2011-09-19", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [], "places_of_operation": [], "biography": "John Dunning (April 27, 1927 – September 19, 2011) was a pioneering Canadian film producer from Montreal who co-founded the Canadian film production company Cinépix and produced early works by notable Canadian directors David Cronenberg and Ivan Reitman. Dunning launched Cinépix with partner André Link in Montreal in the early 1960s. Their biggest commercial success—and the first Canadian box office hit—came with Reitman's Meatballs (1979).", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T15:34:50.797034+10:00", "external_links": [{"id": 4366, "uri": "https://en.wikipedia.org/wiki/John_Dunning_(film_producer)"}], "uuid": "02b876d0-ec8a-4365-b02d-bba53aadfdd1", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "22225", "external_references": [{"id": 25609, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q28648847"}, {"id": 29471, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "29733585"}, {"id": 29472, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no97041581"}, {"id": 29473, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no97041581"}], "date_modified": "2023-09-13T12:30:31.837613+10:00"}, {"id": 36435, "name": "Maurice Pialat", "roles_in_work": [{"id": 890474, "title": "Nous Ne Vieillirons Pas Ensemble = We will not grow old together", "work_id": 115953, "role": "director", "role_id": 938, "is_primary": true}, {"id": 891217, "title": "La Maison des Bois: Episode 5", "work_id": 116353, "role": "director", "role_id": 938, "is_primary": true}, {"id": 891213, "title": "La Maison des Bois: Episode