d": 2306798, "title": "Special delivery", "work_id": 75523, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 2150918, "title": "Magic Flute", "work_id": 75481, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 887081, "title": "The Psychic parrot", "work_id": 97262, "role": "producer/director", "role_id": 31, "is_primary": true}, {"id": 872514, "title": "What the hell's going on up there?", "work_id": 87681, "role": "producer/director", "role_id": 31, "is_primary": true}], "also_known_as": "", "date_of_birth": "1936-06-20", "date_of_death": "2005-11-05", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 1, "name": "English", "slug": "english"}], "places_of_operation": [{"id": 10, "name": "United Kingdom", "slug": "united-kingdom"}], "biography": "Derek Reginald Lamb (20 June 1936 – 5 November 2005) was a British animation filmmaker and producer. While serving as executive producer of the National Film Board of Canada's English Animation Studio from 1976 to 1982, he produced the Oscar-winner Special Delivery, directed by John Weldon and Eunice Macaulay, and produced and scripted Eugene Fedorenko's Every Child. He also created numerous animated sketches for Sesame Street, sometimes in collaboration with John Canemaker.\nIn 1983, he and a former wife, animator Janet Perlman, formed an independent production company. Among their productions was the Sports Cartoons series, which aired on Nickelodeon in the United States. Lamb and Fedorenko collaborated on the first animation sequences for an IMAX film, Skyward, first presented at Expo '85 in Tsukuba, Ibaraki, Japan.\nWith Fedorenko and Perlman, Lamb created the animated title sequence of the PBS series Mystery! based on the art of Edward Gorey, and a series of network ID's for YTV in 1991.\nLamb was also a musician. In 1962, he released an album of songs on Folkways Records titled She Was Poor But She Was Honest after its title track, which included songs drawn from London music halls and pubs.Two years before his death, Lamb appeared, as himself, in the 2004 Oscar-winning animated documentary short film Ryan, directed by Canadian-based animation filmmaker Chris Landreth.\nFrom his first marriage, he had two sons: Richard Steven Lamb (born in London on 27 September 1963) and Thomas Derek Lamb (born in Cambridge on 3 March 1966). He died at the age of 69 from cancer, at a friend's home in Poulsbo, Washington on 5 November 2005.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T19:10:00.953368+10:00", "external_links": [{"id": 3873, "uri": "https://en.wikipedia.org/wiki/Derek_Lamb"}], "uuid": "1187f9ff-f4b0-4c54-a3f3-76b51a8d5491", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "18034", "external_references": [{"id": 26012, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q1200053"}, {"id": 28143, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "6257658"}, {"id": 28144, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n81081003"}, {"id": 28145, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n81081003"}], "date_modified": "2023-09-05T19:10:00.963521+10:00"}, {"id": 15480, "name": "Edward Harrison", "roles_in_work": [{"id": 2463807, "title": "My own yard to play in", "work_id": 70724, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 1817553, "title": "Harlem Wednesday", "work_id": 68323, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 1812135, "title": "The Tender game", "work_id": 73615, "role": "producer", "role_id": 1089, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-08-14T09:58:26.288507+10:00", "external_links": [], "uuid": "23055e6a-5f4a-461f-926d-8f7ace29f691", "source": {"name": "Vernon",