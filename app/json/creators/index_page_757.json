: true}], "also_known_as": "", "date_of_birth": "1928-10-26", "date_of_death": "2020-02-04", "places_of_operation": [{"id": 19, "name": "Italy", "slug": "italy"}], "biography": "Gianni Minervini (26 October 1928 – 4 February 2020) was an Italian actor and  television and film producer.\nBorn in Naples, Minervini was the son of the journalist  Roberto Minervini. He debuted as a producer in 1976, when he co-founded with the brothers Antonio and Pupi Avati the production company A.M.A. Film. The Avati brothers left the company in late 1983, leaving the sole Minervini leading the company alone.Minervini won three David di Donatello Awards for best producer, in 1982, 1984 and 1990. He also won a Nastro d'Argento in 1984 for the production of Where's Picone?.\n\n", "biography_author": "Wikidata", "date_of_biography": "2022-05-19T11:37:58.311126+10:00", "external_links": [{"id": 2145, "uri": "https://en.wikipedia.org/wiki/Gianni_Minervini_(producer)"}], "uuid": "a6c4ea0f-5751-4b88-b26d-d912fe40661e", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": null, "external_references": [{"id": 9237, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q3763577"}, {"id": 9238, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "26768426"}, {"id": 9239, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no2004012941"}, {"id": 9240, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no2004012941"}], "date_modified": "2023-06-14T16:33:30.576250+10:00"}, {"id": 77824, "name": "Vittorio Cecchi Gori", "roles_in_work": [{"id": 1998382, "title": "Volere volare", "work_id": 93753, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 1993677, "title": "The Star maker = L'Uomo Delle Stelle", "work_id": 89407, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 1993356, "title": "The Legend of the holy drinker", "work_id": 88970, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 1989262, "title": "Mediterraneo", "work_id": 85082, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 909285, "title": "The Postman = Il Postino", "work_id": 89776, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": "1942-04-27", "date_of_death": null, "places_of_operation": [{"id": 19, "name": "Italy", "slug": "italy"}], "biography": "Vittorio Cecchi Gori (Italian pronunciation: [vitˈtɔːrjo ˈtʃekki ˈɡɔːri]; born 27 April 1942) is an Italian film producer and politician. \nHe pleaded guilty to bankruptcy and was sentenced in February 2020 to 8 years and 5 months of imprisonment.Born in Florence, Italy he is the son of Mario Cecchi Gori. He has produced numerous films, most notably Il Postino: The Postman (1994), which received an Academy Award nomination for Best Picture and Life Is Beautiful (1997) which received an Academy Award for Best Foreign Language Film.\nHe was also senator from the Italian People's Party.\nHe owned the football club A.C. Fiorentina from 1993 to 2002, as well as the private television channel La7. On 3 June 2008, he was arrested in Rome for bankruptcy and on 25 July 2011 again.", "biography_author": "Wikidata", "date_of_biography": "2022-05-19T13:19:53.272248+10:00", "external_links": [{"id": 3263, "uri": "https://en.wikipedia.org/wiki/Vittorio_Cecchi_Gori"}], "uuid": "651225b6-496b-4575-b4f3-54848d469dea", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": null, "external_references": [{"id": 13808, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q1459321"}, {"id": 13809, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "87051151"}, {"id": 13810, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no97053479"}, {"id": 13811, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no97053479"}], "date_modified": "2023-06-14T16:33:30.576250+10:00"}, {"id": 77823, "name": "Bruce Joel Rubin", "roles_in_work": [], "also_known_as": "", "date_of_birth": "1943-03-10", "date_of_death": null, "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Bruce Joel Rubin (born March 10, 1943) is an American screenwriter, meditation teacher, and photographer. His films often explore themes of life and death with metaphysical and science fiction elements. Prominent among them are Jacob’s Ladder, My Life and Ghost, for which he received the Oscar for Best Original Screenplay. Ghost was also nominated for Best Picture, and was the highest-grossing film of 1990. He is sometimes credited as \"Derek Saunders\" or simply \"Bruce Rubin\".\n\n", "biography_author": "Wikidata", "date_of_biography": "2022-05-19T10:59:58.660989+10:00", "external_links": [{"id": 1758, "uri": "https://en.wikipedia.org/wiki/Bruce_Joel_Rubin"}], "uuid": "11a1350e-5059-4195-b6a5-9a318a16d9b6", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": null, "external_references": [{"id": 7668, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q991682"}, {"id": 7669, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "4098850"}, {"id": 7670, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n90698855"}, {"id": 7671, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n90698855"}], "date_modified": "2023-06-14T16:33:30.576250+10:00"}]}