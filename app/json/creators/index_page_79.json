{"count": 26454, "next": "https://api.acmi.net.au/creators/?page=80", "previous": "https://api.acmi.net.au/creators/?page=78", "results": [{"id": 86010, "name": "Sadia Sadia", "roles_in_work": [{"id": 2467545, "title": "The Memory of Water (part 1)", "work_id": 109650, "role": "creator", "role_id": 968, "is_primary": true}], "also_known_as": "", "date_of_birth": "1957", "date_of_death": "", "genders": [{"id": 5, "name": "Female", "slug": "female"}], "languages": [], "places_of_operation": [], "biography": "Sadia is a Canadian-born, UK-based filmmaker and installation artist.  She is also an award-winning record producer and writer.  Sadia started her career in music, going on to expand her interests as an artist in multiple media.  She has exhibited as a painter and stills photographer in London and Milan and is currently working with moving images as a director and editor, as well as producing installation pieces, audio and experimental films.  Her films have been included in MIFF 2004 and shown at the National Film and Television Museum in the UK.  Sadia has been involved with women's rights activism and has campaigned against racism and hate speech in print and broadcast media.  She has an MSc in political science and economics from the University of London and an MA in design from Central St Martins College of Art and Design.\n\nTaken from the PROOF exhibition 2004.", "biography_author": null, "date_of_biography": "2023-08-14T11:22:27.410795+10:00", "external_links": [], "uuid": "c21d7d11-17f5-48a2-93e1-f4b784e0c5dc", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "2035", "external_references": [], "date_modified": "2023-08-14T11:22:27.411067+10:00"}, {"id": 86009, "name": "Philips Interactive Media, Inc.", "roles_in_work": [{"id": 2494218, "title": "Emulation for The Dame Was Loaded for DOS", "work_id": 119973, "role": "publisher", "role_id": 942, "is_primary": true}, {"id": 2494226, "title": "The Dame Was Loaded", "work_id": 119781, "role