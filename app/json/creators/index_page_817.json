{"count": 25105, "next": "https://api.acmi.net.au/creators/?page=818", "previous": "https://api.acmi.net.au/creators/?page=816", "results": [{"id": 77235, "name": "Alan Johnson", "roles_in_work": [{"id": 2269126, "title": "To be or not to be (Captioned)", "work_id": 82749, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1937-02-18", "date_of_death": "2018-07-08", "genders": [], "languages": [], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Alan Johnson (February 18, 1937 – July 7, 2018) was a three-time Emmy Award-winning  American choreographer, best known for his work on Mel Brooks films and for restaging Jerome Robbins' original choreography in live productions of West Side Story in the United States and internationally. Johnson was linked to West Side Story since making his Broadway debut in the show in 1957.He brought the West Side Story dance style into the mainstream when he choreographed several GAP clothing commercials in 2000. This commercial earned him an American Choreography award. Along with the GAP/WestSide advertisements, Johnson also choreographed commercials for Dubonnet and Freixenet Champagne.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T13:56:02.969901+10:00", "external_links": [{"id": 3501, "uri": "https://en.wikipedia.org/wiki/Alan_Johnson_(choreographer)"}], "uuid": "b19dd6e2-72b7-4a2f-a586-075363bd2046", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "14770", "external_references": [{"id": 26808, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q4706981"}, {"id": 27129, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "233351382"}, {"id": 27130, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "nb2012007164"}, {"id": 27131, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-nb20120071