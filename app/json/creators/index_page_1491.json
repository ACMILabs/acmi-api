{"count": 25130, "next": "https://api.acmi.net.au/creators/?page=1492", "previous": "https://api.acmi.net.au/creators/?page=1490", "results": [{"id": 31199, "name": "Sam Taylor", "roles_in_work": [{"id": 2110454, "title": "Before the rain = Pred dozhdot", "work_id": 89261, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 1994074, "title": "The Young poisoner's handbook", "work_id": 89778, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 884354, "title": "My best girl [NTSC]", "work_id": 94637, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1895-08-13", "date_of_death": "1958-03-06", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 1, "name": "English", "slug": "english"}], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Sam Taylor (August 13, 1895 – March 6, 1958) was an American film director, screenwriter, and producer, most active in the silent film era. Taylor is best known for his comedic directorial work with Harold Lloyd and Mary Pickford, and also later worked with Laurel and Hardy. He was born in New York City.\nA notorious cinematic legend over the decades has suggested that Taylor's 1929 adaptation of Shakespeare's The Taming of the Shrew had the screen credit \"additional dialogue by Sam Taylor\".  However, no extant prints of the film contain this credit, and there is no documentary evidence that it ever existed.\nTaylor directed seven feature films with Lloyd as star, second only to Fred C. Newmeyer (the two co-directed Lloyd in five features). He also directed Pickford in her first \"talkie\" feature with Coquette (1929), which garnered the latter an Academy Award. \nTaylor died at the age of 62 in Santa Monica, California.", "biography_author": "Wikidata", "date_of_biography": "2023-09-06T01:03:18.638023+10:00", "external_links": [{"id": 6165, "uri": "https://en.wikipedia.org/wiki/Sam_Taylor_(director)"}], "uuid": "a161031e-c406-45d9-87a8-15ada0dc18e8", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "28497", "external_references": [{"id": 50751, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q719427"}, {"id": 55753, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "37198878"}, {"id": 55754, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n86075569"}, {"id": 55755, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n86075569"}], "date_modified": "2023-09-06T01:03:23.703116+10:00"}, {"id": 31196, "name": "Vardar Films", "roles_in_work": [{"id": 2110447, "title": "Before the rain = Pred dozhdot", "work_id": 89261, "role": "production company", "role_id": 941, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T12:45:17.593275+10:00", "external_links": [], "uuid": "217deec0-47a7-48f3-9e13-1373d4607f75", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "13996", "external_references": [], "date_modified": "2023-06-14T16:33:30.576250+10:00"}, {"id": 31195, "name": "Noe Productions", "roles_in_work": [{"id": 2164858, "title": "No man's land = Nikogarsnja zemlja [DVD]", "work_id": 94304, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2164199, "title": "No man's land = Nikogarsnja zemlja", "work_id": 100503, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2110446, "title": "Before the rain = Pred dozhdot", "work_id": 89261, "role": "production company", "role_id": 941, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T