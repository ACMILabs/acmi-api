e": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q508777"}, {"id": 31266, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "29673142"}, {"id": 31267, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n78064052"}, {"id": 31268, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n78064052"}], "date_modified": "2023-09-06T00:51:10.084815+10:00"}, {"id": 83041, "name": "Alain Delon", "roles_in_work": [{"id": 1806408, "title": "Les Seins de Glace = Icy Breasts", "work_id": 116258, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 2228427, "title": "Pour la Peau D'un Flic = for a Cop's Hide", "work_id": 116229, "role": "producer/director", "role_id": 31, "is_primary": true}, {"id": 890472, "title": "Le Battant = the Cache", "work_id": 115952, "role": "producer/director", "role_id": 31, "is_primary": true}], "also_known_as": "Alain Fabien Maurice Marcel Delon", "date_of_birth": "1935-11-08", "date_of_death": "", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 4, "name": "French", "slug": "french"}], "places_of_operation": [{"id": 17, "name": "France", "slug": "france"}], "biography": "Alain Fabien Maurice Marcel Delon (French: [alɛ̃ dəlɔ̃]; born 8 November 1935) is a French actor, filmmaker, and businessman. He was one of Europe's most prominent actors and screen sex symbols in the 1960s, 1970s and 1980s. In 1985, he won the César Award for Best Actor for his performance in Notre histoire (1984). In 1991, he received France's Legion of Honour. At the 45th Berlin International Film Festival, he won the Honorary Golden Bear. At the 2019 Cannes Film Festival, he received the Honorary Palme d'Or. He is considered to be one of the most handsome men to exist.\nDelon achieved critical acclaim for roles in films Purple Noon (1960), Rocco and His Brothers (1960), L'Eclisse (1962), The Leopard (1963), Le Samouraï (1967), La Piscine (1969), Le Cercle Rouge (1970), Un flic (1972), and Monsieur Klein (1976). Over the course of his career Delon worked with many directors, including Luchino Visconti, Jean-Luc Godard, Jean-Pierre Melville, Michelangelo Antonioni, and Louis Malle. As a singer, Delon recorded the popular duet \"Paroles, paroles\" (1973) with Dalida. He acquired Swiss citizenship in 1999.\n\n", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T13:55:05.891869+10:00", "external_links": [{"id": 1568, "uri": "https://en.wikipedia.org/wiki/Alain_Delon"}], "uuid": "ca2b642b-91ee-4673-b288-81961e49b980", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "31077", "external_references": [{"id": 6875, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q106529"}, {"id": 6876, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "69115231"}, {"id": 6877, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n83011368"}, {"id": 6878, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n83011368"}], "date_modified": "2023-09-05T17:18:37.179387+10:00"}, {"id": 83040, "name": "Adel Productions", "roles_in_work": [{"id": 890470, "title": "Le Battant = the Cache", "work_id": 115952, "role": "production company", "role_id": 941, "is_primary": true}], "also_known_as": "", "date_of_birth": null, "date_of_death": null, "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": null, "external_links": [], "uuid": "f140b469-bed0-4c68-898d-f09bcf2eb5a4", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": null, "external_references": [{"id": 36399, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q121223565"}], "date_modified": "2023-09-05T17:16:22.507714+10:00"}, {"id": 83039, "name": "Comptoir Francais du Film Production (CFFP)", "roles_in_work": [{"id": 890468, "title": "Judex (English Version)", "work_id": 115951, "ro