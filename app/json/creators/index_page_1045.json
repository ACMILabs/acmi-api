{"count": 25099, "next": "https://api.acmi.net.au/creators/?page=1046", "previous": "https://api.acmi.net.au/creators/?page=1044", "results": [{"id": 74951, "name": "Janet Perlman", "roles_in_work": [{"id": 2192009, "title": "Dinner for two", "work_id": 85828, "role": "director", "role_id": 938, "is_primary": true}, {"id": 764311, "title": "The Tender tale of Cinderella penguin", "work_id": 77397, "role": "producer/director", "role_id": 31, "is_primary": true}, {"id": 919094, "title": "Why me?", "work_id": 98103, "role": "co-producers/directors", "role_id": 628, "is_primary": true}, {"id": 894845, "title": "Lady Fishbourne's Complete Guide to Better Table Manners", "work_id": 69469, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1954-09-19", "date_of_death": "", "places_of_operation": [{"id": 36, "name": "Canada", "slug": "canada"}], "biography": "Janet Laurie Perlman is a Canadian animator and children's book author and illustrator whose work includes the short film The Tender Tale of Cinderella Penguin, which was nominated for an Academy Award for Best Animated Short Film at the 54th Academy Awards and received a Parents' Choice Award. Her 13 short films have received 60 awards to date. She was married to the late animation producer Derek Lamb. After working with Lamb at the National Film Board of Canada in the 1980s, they formed their own production company, Lamb-Perlman Productions. She is currently a partner in Hulascope Studio, based in Montreal. Perlman has produced animation segments for Sesame Street and NOVA. Working with Lamb, she produced title sequences for the PBS series Mystery!, based on the artwork of Edward Gorey, and was one of the animators for R. O. Blechman's adaptation of The Soldier's Tale for PBS's Great Performances. She has also taught animation at Harvard University, the Rhode Island School of Design and Concordia University. She and Lamb were divorced but remained creative and business partners until his death in 2005.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T15:24:17.231609+10:00", "external_links": [{"id": 4273, "uri": "https://en.wikipedia.org/wiki/Janet_Perlman"}], "uuid": "da9fb44c-1340-462b-bf6c-f17fd74e287c", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "21446", "external_references": [{"id": 26043, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q2506671"}, {"id": 29227, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "50873371"}, {"id": 29228, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n91121708"}, {"id": 29229, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n91121708"}], "date_modified": "2023-08-15T11:18:48.884504+10:00"}, {"id": 74950, "name": "Audrey McLaren", "roles_in_work": [{"id": 894833, "title": "Kumak the sleepy hunter: a film based on an old Eskimo tale", "work_id": 69455, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": null, "date_of_death": null, "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": null, "external_links": [], "uuid": "fce26ba7-45cd-4d8b-9d07-b866c1607eca", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": null, "external_references": [{"id": 38076, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q121337238"}], "date_modified": "2023-06-14T16:33:30.576250+10:00"}, {"id": 74949, "name": "Alma Duncan", "roles_in_work": [{"id": 894832, "title": "Kumak the sleepy hunter: a film based on an old Eskimo tale", "work_id": 69455, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": null, "date_of_death": null, "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": null, "external_links": [], "uuid": "18fc696b-a5a0-44fe-906f-f38dfce00fe0", "source": {"name