{"count": 26430, "next": "https://api.acmi.net.au/creators/?page=724", "previous": "https://api.acmi.net.au/creators/?page=722", "results": [{"id": 78187, "name": "David V. Picker", "roles_in_work": [{"id": 2341615, "title": "The Crucible", "work_id": 86146, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 2180516, "title": "Dead men don't wear plaid [DVD]", "work_id": 92632, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 2109136, "title": "Beat Street", "work_id": 94498, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": "1931-05-14", "date_of_death": "2019-04-20", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "David Victor Picker (May 14, 1931 – April 20, 2019) was an American motion picture executive and producer, working in the film industry for more than forty years. He served as president and chief executive officer for United Artists, Paramount, Lorimar, and Columbia Pictures before becoming an independent producer. Picker was a member of the Writers Guild of America East, a member the Producers Guild of America, and he was Chairman Emeritus of the Producers Guild of America East. Picker's memoir about his career in the film industry, Musts, Maybes and Nevers, was released in 2013.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T14:36:34.663001+10:00", "external_links": [{"id": 3857, "uri": "https://en.wikipedia.org/wiki/David_V._Picker"}], "uuid": "01f0934b-6c46-4704-977d-71eb9784fd7b", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "17829", "external_references": [{"id": 25716, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q5240588"}, {"id": 28093, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "92866831"}, {"id": 28094, "source": {"name": "L