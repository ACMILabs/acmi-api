wikidata"}, "source_identifier": "Q9012349"}, {"id": 10279, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "7082528"}, {"id": 10280, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no2003071686"}, {"id": 10281, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no2003071686"}], "date_modified": "2023-08-01T15:33:59.050556+10:00"}, {"id": 78354, "name": "Allen Shapiro", "roles_in_work": [{"id": 1995328, "title": "The Quick and the dead", "work_id": 91443, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 1991221, "title": "Universal soldier", "work_id": 86884, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": "1947-07-25", "date_of_death": null, "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Allen Shapiro is a media executive and investor. He is the former executive chairman and CEO of Dick Clark Productions (DCP), a former chairman of TV Guide, and a former entertainment lawyer. Shapiro was the executive producer of DCP's flagship programming and oversaw the development, production and licensing of the company's high-profile properties. Since 1999, he is a managing partner of Mosaic Media Investment Partners production and talent management company.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T14:00:07.753364+10:00", "external_links": [{"id": 3533, "uri": "https://en.wikipedia.org/wiki/Allen_Shapiro"}], "uuid": "65aed6e7-cbf0-4346-8b61-fde4f9115bfc", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": null, "external_references": [{"id": 26547, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q4731870"}], "date_modified": "2023-08-01T14:00:07.778225+10:00"}, {"id": 78353, "name": "Jeff Most", "roles_in_work": [{"id": 2341479, "title": "The Crow: salvation", "work_id": 94283, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 2341423, "title": "The Crow: City of angels", "work_id": 86868, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 2341371, "title": "The Crow", "work_id": 86869, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": "1960-09-15", "date_of_death": "", "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Jeff Most (born September 15, 1960) is an American film producer, best known as the producer and music supervisor of The Crow film series.\nMost was co-producer on The Crow with Edward R. Pressman in 1993, and also produced the film's soundtrack album. He produced the films and soundtracks for the subsequent entries in the franchise: The Crow: City of Angels (1996), The Crow: Salvation (2000) and The Crow: Wicked Prayer (2005).Jeff Most has also produced films such as The Specialist, Girl, Venice Underground, The Tomb and On The Doll. In early 2007, he produced a film called Kingshighway, reuniting him with The Crow: Wicked Prayer star Edward Furlong. The film starred and was directed by Clayne Crawford.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T15:28:36.088646+10:00", "external_links": [{"id": 2358, "uri": "https://en.wikipedia.org/wiki/Jeff_Most"}], "uuid": "44bf7a40-e206-4f16-9217-6418e011d47d", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "21648", "external_references": [{"id": 10110, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q6174567"}, {"id": 10111, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "9527605"}, {"id": 10112, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no2003019890"}, {"id": 10113, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no2003019890"}], "date_modified": "2023-08-01T15:28:36.102916+10:00"}]}