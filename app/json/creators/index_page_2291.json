e": "The Railway children. Swallows and amazons [DVD]", "work_id": 94947, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2183032, "title": "Death on the Nile", "work_id": 85589, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2344884, "title": "The Driver", "work_id": 87820, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 816412, "title": "Maria Callas in concert: Hamburg, 18 May, 1959 and 16 March, 1962", "work_id": 93650, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 896711, "title": "Who needs the computer?", "work_id": 75915, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 1848421, "title": "Meeting people is easy [A Film about Radiohead]", "work_id": 94255, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 1988804, "title": "Frances", "work_id": 84813, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 1997461, "title": "Southern comfort", "work_id": 93324, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 755468, "title": "The Third side", "work_id": 73706, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 794955, "title": "The Beatles Anthology 8. July 1968 to the End", "work_id": 87060, "role": "production company", "role_id": 941, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "EMI Group Limited (originally an initialism for Electric and Musical Industries, also referred to as EMI Records Ltd. or simply EMI) was a British transnational conglomerate founded in March 1931 in London. At the time of its acquisition by Universal Music in 2012, it was the fourth largest business group and record label conglomerate in the music industry, and was one of the \"Big Four\" record companies (now the \"Big Three\"). Its labels included EMI Records, Parlophone, Virgin Records, and Capitol Records, which are now referenced under Universal Music due to their acquisition with the exception of Parlophone, as it is now owned by Warner Music.\nEMI was listed on the London Stock Exchange, and was also once a constituent of the FTSE 100 Index, but faced financial problems and US$4 billion in debt, leading to its acquisition by Citigroup in February 2011. Citigroup's ownership was temporary, as EMI announced in November 2011 that it would sell its music arm to Vivendi's Universal Music Group for $1.9 billion and its publishing business to a Sony/ATV consortium for around $2.2 billion. Other members of the Sony consortium include the estate of Michael Jackson, the Blackstone Group, and the Abu Dhabi–owned Mubadala Development Company. EMI's locations in the United Kingdom, the United States, and Canada were all disassembled to repay debt, but the primary head office located outside those countries is still functional.EMI Music Publishing is now owned by Sony/ATV Music Publishing, the music publishing division of Sony Music which bought another 70% stake in EMI Music Publishing.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T19:31:45.109349+10:00", "external_links": [{"id": 5798, "uri": "https://en.wikipedia.org/wiki/EMI"}], "uuid": "4095b033-8cd5-4a9b-a457-151a492444b6", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "111092", "external_references": [{"id": 32634, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q183412"}, {"id": 54381, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "153494571"}, {"id": 54382, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no97009953"}, {"id": 54383, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "viaf-153494571"}], "date_modified": "2023-09-05T19:31:49.724381+10:00"}]}