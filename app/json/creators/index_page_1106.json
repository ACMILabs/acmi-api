ified": "2023-08-09T03:57:23.722257+10:00"}, {"id": 74349, "name": "John Spotton", "roles_in_work": [{"id": 2229594, "title": "Prisoners of debt: inside the global banking crisis", "work_id": 92946, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 2138638, "title": "Class of promise", "work_id": 78477, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 2128089, "title": "Buster Keaton rides again", "work_id": 65694, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2072537, "title": "A Pinto for the Prince", "work_id": 90761, "role": "co-director", "role_id": 959, "is_primary": true}, {"id": 2069308, "title": "A House divided: caregiver stress and elder abuse", "work_id": 92953, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 912821, "title": "Hayley's home movie", "work_id": 92925, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 912856, "title": "Left out", "work_id": 92933, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 912912, "title": "Where's Pete?", "work_id": 92952, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 912924, "title": "Mr Nobody", "work_id": 92956, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 790916, "title": "Have I ever lied to you before?", "work_id": 85771, "role": "director", "role_id": 938, "is_primary": true}, {"id": 895052, "title": "Memorandum", "work_id": 70290, "role": "co-director", "role_id": 959, "is_primary": true}], "also_known_as": "", "date_of_birth": "1927-01-01", "date_of_death": "1991-03-03", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [], "places_of_operation": [{"id": 36, "name": "Canada", "slug": "canada"}], "biography": "John Spotton C.S.C. (January 1, 1927 – March 3, 1991) was a Canadian filmmaker with the National Film Board of Canada.\nA versatile artist who worked as a director, producer, cinematographer and editor, Spotton was best known for his role in developing the Direct Cinema genre of documentary and in the application of those techniques in narrative fiction films, in particular Nobody Waved Good-bye (1964), in which he served as cinematographer and editor.An early member of the Canadian Society of Cinematographers (CSC), Spotton briefly working as a cameraman for a private company, joined the NFB in 1949 and worked there for the rest of his life, with the exception of a three-film stint with Parker Film Associates, and a two-year period in the 1970s when he worked with Potterton Productions. He was executive director of the NFB's Ontario Centre from 1982 until 1988.Until it closed in 2002, The NFB's theatre in Toronto was named The John Spotton Theatre.\nUntil 2017, the Toronto International Film Festival Award for Best Canadian Short Film was the 'NFB John Spotton Award'.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T15:39:41.078887+10:00", "external_links": [{"id": 4410, "uri": "https://en.wikipedia.org/wiki/John_Spotton"}], "uuid": "0b52e6e3-bb3d-4166-8122-7e6b90c8189a", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "1777", "external_references": [{"id": 26235, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q6258695"}, {"id": 29585, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "105771523"}, {"id": 29586, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no2007085011"}, {"id": 29587, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no2007085011"}], "date_modified": "2023-09-05T21:44:47.886126+10:00"}, {"id": 74348, "name": "Rick Wise", "roles_in_work": [{"id": 2127728, "title": "Burn emergency", "work_id": 65682, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2