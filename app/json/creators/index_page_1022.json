r": null, "date_of_biography": "2023-05-09T15:04:29.617603+10:00", "external_links": [], "uuid": "e8d246c3-2402-44f8-9b63-e9fe1786b738", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "18605", "external_references": [], "date_modified": "2023-06-14T16:33:30.576250+10:00"}, {"id": 75177, "name": "Arthur Mayer", "roles_in_work": [{"id": 2188133, "title": "Paris 1900", "work_id": 71363, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": "1886-03-28", "date_of_death": "1981-04-14", "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Arthur L. Mayer (March 28, 1886, Demopolis, Alabama - April 14, 1981, New York City) was an American film producer and film distributor who worked with Joseph Burstyn in distributing films directed by Roberto Rossellini and other famous European film directors. Some films were distributed under the name Burstyn-Mayer Inc. Mayer was also interviewed by Warren Beatty for Beatty's film Reds (1981).\nIn 1949, Mayer went into business to distribute French films in the U.S. with Edward Kingsley, who later founded Kingsley-International Pictures.Mayer was co-producer of the French documentary film La Vie Commence Demain (Life Begins Tomorrow, 1950), directed by Nicole Védrès and featuring Pablo Picasso and Jean-Paul Sartre, as well as the feature film High Hell (1958). He was married to Lillie Mayer (born July 29, 1889).", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T14:07:17.710465+10:00", "external_links": [{"id": 3595, "uri": "https://en.wikipedia.org/wiki/Arthur_Mayer"}], "uuid": "50c148bc-1731-428c-affb-967d02373afd", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "15551", "external_references": [{"id": 25416, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q16009504"}, {"id": 27375, "source": {"name": "VIAF", "slug": "viaf"}, "source_iden