{"count": 20458, "next": "https://api.acmi.net.au/creators/?page=1302", "previous": "https://api.acmi.net.au/creators/?page=1300", "results": [{"id": 36041, "name": "Riyad Vinci Wadia", "roles_in_work": [{"id": 2238651, "title": "Fearless: the Hunterwali story", "work_id": 94136, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1967-09-19", "date_of_death": "2003-11-30", "places_of_operation": [{"id": 50, "name": "India", "slug": "india"}], "biography": "Riyad Vinci Wadia (19 September 1967 – 30 November 2003) was an Indian independent filmmaker from Bombay, known for his short film, BOMgAY (1996), possibly the very first gay themed movie from India. Born into the filmmaking Wadia family, he inherited the production company Wadia Movietone which is known for the Fearless Nadia movies which are one of their kind in the superwoman and stunt genre when other movies of their time usually portrayed women in submissive roles.  Wadia is also known for his award-winning documentary on Nadia, Fearless: The Hunterwali Story (1993), which was written about in Time magazine and made a name for Riyad at the very outset of his brief but impactful career.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T16:47:06.321539+10:00", "external_links": [{"id": 5001, "uri": "https://en.wikipedia.org/wiki/Riyad_Vinci_Wadia"}], "uuid": "30f2fdc0-d604-4891-ad23-83d325d58162", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "27579", "external_references": [{"id": 26538, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q7339025"}, {"id": 31112, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "2114151247983144270000"}, {"id": 31113, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "viaf-2114151247983144270000"}], "date_modified": "2023-08-01T16:47:06.342877+10:00"}, {"id": 36040, "name": "Wadia Movietone", "roles_in_work": [{"id": 2238646, "titl