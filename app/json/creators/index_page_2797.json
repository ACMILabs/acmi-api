{"count": 28689, "next": "https://api.acmi.net.au/creators/?page=2798", "previous": "https://api.acmi.net.au/creators/?page=2796", "results": [{"id": 9096, "name": "Simon Norton", "roles_in_work": [{"id": 2711131, "title": "Testimony: a story machine", "work_id": 109017, "role": "creator", "role_id": 968, "is_primary": true}], "also_known_as": "", "date_of_birth": null, "date_of_death": null, "genders": [], "languages": [], "places_of_operation": [], "biography": "Simon Norton is a multimedia artist who works in many areas, including writing, animation, comics, sound collage, and web design. He has studied film, writing, painting, audio engineering and multimedia. He is principally interested in ideas and concept-driven works, and exploring the potentials of interactive fiction, interactive comics and interactive iconography.\n\"Testimony: A Story Machine\" won a place in the New talent Competition at MILIA 2002, Cannes, France, won the Megabite Digital Film Project at Next Wave Festival 2002, Melbourne Australia, won Best Short in the web category at I Castelli Animati International Animated Film Festival 7th Edition 2002 in Rome Italy, won second place in the Interactive Storytelling category at Mecon in Cologne, Germany, was part of the Prototype exhibition at the Victorian Arts Centre and was a finalist in several other website competitions", "biography_author": null, "date_of_biography": "2025-03-11T23:46:52.599279+11:00", "external_links": [], "uuid": "f77203ad-fa38-41e1-9774-3ce3f98bf86c", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "111998", "external_references": [], "date_modified": "2025-03-11T23:46:52.599598+11:00"}, {"id": 9095, "name": "Paul Brown", "roles_in_work": [{"id": 2711127, "title": "Chromos", "work_id": 109016, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1807318, "title": "Arguing the Toss of a Cat", "work_id": 79247, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 2711129, "title":