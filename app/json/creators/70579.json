{"id": 70579, "name": "Charles-Émile Reynaud", "roles_in_work": [{"id": 2108589, "title": "Le Trapèze (The Trapeze)\npraxinoscope strip", "work_id": 99649, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 2108569, "title": "La Charmeuse (The Charmer)\npraxinoscope strip", "work_id": 99650, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 2108528, "title": "La Rosace Magique (The Magic Rosette)\npraxinoscope strip", "work_id": 99651, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 2108500, "title": "Le jongleur (The juggler) praxinoscope strip", "work_id": 99654, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1858566, "title": "Praxinoscope with wooden base", "work_id": 99446, "role": "inventor", "role_id": 884, "is_primary": false}, {"id": 1855699, "title": "Praxinoscope Théâtre advertisement", "work_id": 99655, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1855689, "title": "Praxinoscope Théâtre", "work_id": 99481, "role": "inventor", "role_id": 884, "is_primary": false}, {"id": 1855688, "title": "Praxinoscope Théâtre", "work_id": 100578, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1823471, "title": "Toupie-fantoche (Spinning Top)", "work_id": 100288, "role": "designer", "role_id": 495, "is_primary": false}], "also_known_as": "", "date_of_birth": "1844", "date_of_death": "1910", "places_of_operation": [], "biography": "Charles-Émile Reynaud (8 December 1844 – 9 January 1918) was a French inventor, responsible for the praxinoscope (an animation device patented in 1877 that improved on the zoetrope) and the first projected animated films. His Pantomimes Lumineuses premiered on 28 October 1892 in Paris. His Théâtre Optique film system, patented in 1888, is also notable as the first known instance of film perforations being used. The performances predated Auguste and Louis Lumière's first paid public screening of the cinematographe on 26 December 1895, often seen as the birth