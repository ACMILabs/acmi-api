{"count": 20319, "next": "https://api.acmi.net.au/creators/?page=94", "previous": "https://api.acmi.net.au/creators/?page=92", "results": [{"id": 84860, "name": "Eiki Industrial Co., Ltd.", "roles_in_work": [{"id": 2063898, "title": "16MM Sound Projector, RST Series", "work_id": 118263, "role": "creator", "role_id": 968, "is_primary": true}], "also_known_as": "", "date_of_birth": "1953", "date_of_death": "", "places_of_operation": [], "biography": "EIKI was founded in 1953 in Osaka by M. Matsuura, S. Yagi, K. Sekino and Y. Minagawa. The focus of the company was manufacturing equipment for classroom AV needs and later on, the company focused more on manufacturing 16mm projectors.\n\nEIKI had manufactured 8mm projectors for a short time in the past, but never attempted to offer 35mm projectors, instead of this, it had tried to market Tokiwa 35mm portables.\n\nEIKI had a vast variety of model availability in 16mm projectors among the other Japanese manufacturers.\n\nMost models are re-branded as elf in the UK, INTERNATIONAL and BELL+HOWELL in the U.S., as well as HANIMEX EIKI in Australia.", "biography_author": null, "date_of_biography": "2023-05-09T11:20:00.776195+10:00", "external_links": [], "uuid": "d2a5af0e-6f82-4cfe-a42f-0a255bbbc401", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "39399", "external_references": [], "date_modified": "2023-06-14T16:33:30.576250+10:00"}, {"id": 84859, "name": "Rank Arena", "roles_in_work": [{"id": 2210606, "title": "Portable Black and White TV", "work_id": 118262, "role": "distributor", "role_id": 437, "is_primary": false}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T15:44:38.220612+10:00", "external_links": [], "uuid": "70ac9909-4067-4c49-973b-546343335465", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "39433", "external_references": [], "date_modified": "2023-06-