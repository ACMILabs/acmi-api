phy became Head of Entertainment at the ABC.", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T16:10:18.284336+10:00", "external_links": [{"id": 2676, "uri": "https://en.wikipedia.org/wiki/Maurice_Murphy_(director)"}], "uuid": "20df535d-fbd1-4ebf-a702-14a144879b2b", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "24840", "external_references": [{"id": 11427, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q6793366"}], "date_modified": "2023-09-05T22:56:34.488045+10:00"}, {"id": 76771, "name": "Marj Pearson", "roles_in_work": [{"id": 2649159, "title": "The Winds of Jarrah", "work_id": 80975, "role": "co-producers/directors", "role_id": 628, "is_primary": true}], "also_known_as": "", "date_of_birth": null, "date_of_death": null, "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": null, "external_links": [], "uuid": "af83b282-2925-4442-aeb6-2c91a915fc32", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "24455", "external_references": [], "date_modified": "2025-03-05T13:56:53.657969+11:00"}, {"id": 76770, "name": "Robert Lagettie", "roles_in_work": [{"id": 2281430, "title": "The Time guardian", "work_id": 80974, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T18:01:08.484972+10:00", "external_links": [], "uuid": "855a7b55-ffd5-49b5-9aeb-51ab6f1f427d", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "27801", "external_references": [{"id": 36961, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q121036349"}], "date_modified": "2023-09-06T00:43:48.680658+10:00"}, {"id": 76769, "name": "Patrick Palmer", "roles_in_work": [{"id": 2095564, "title": "And justice for all [