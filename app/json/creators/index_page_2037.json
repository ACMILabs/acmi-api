rnon", "slug": "vernon"}, "source_identifier": "111108", "external_references": [], "date_modified": "2023-06-14T16:33:30.576250+10:00"}, {"id": 89, "name": "Jem Cohen", "roles_in_work": [{"id": 92, "title": "Lost book found", "work_id": 2, "role": "creator", "role_id": 968, "is_primary": false}, {"id": 1913295, "title": "Buried in light", "work_id": 107967, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1913296, "title": "Buried in light", "work_id": 107967, "role": "film maker", "role_id": 459, "is_primary": false}, {"id": 2041666, "title": "Lost book found", "work_id": 114009, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 2041670, "title": "This is a history of New York", "work_id": 107978, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1900948, "title": "Just hold still. Parts one and two", "work_id": 107920, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 2041750, "title": "Instrument", "work_id": 108187, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1901107, "title": "The Golden Dark Age of Reason", "work_id": 108380, "role": "director", "role_id": 938, "is_primary": true}, {"id": 729008, "title": "Jem Cohen interviewed by Emma Crimmings", "work_id": 108401, "role": "interviewee", "role_id": 496, "is_primary": false}, {"id": 1901516, "title": "Drink Deep", "work_id": 109819, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1882744, "title": "Free shadow movies", "work_id": 113997, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 2111667, "title": "Benjamin Smoke", "work_id": 94356, "role": "co-producers/directors", "role_id": 628, "is_primary": true}, {"id": 1548264, "title": "Jem Cohen: early works", "work_id": 107921, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1863684, "title": "Chain times three", "work_id": 108185, "role": "creator", "role_id": 968, "is_primary": true}, {"id": 1863685, "title": "Chain times three", "work_id": 108185, "role": "director", "role_id": 938, "is_primary": true}, {"id": 1863686, "title": "Chain times three", "work_id": 108185, "role": "editor", "role_id": 918, "is_primary": true}, {"id": 1911915, "title": "Black Hole Radio", "work_id": 107979, "role": "creator", "role_id": 968, "is_primary": true}], "also_known_as": "", "date_of_birth": "1962", "date_of_death": "", "places_of_operation": [], "biography": "New York filmmaker Jem Cohen's prizewinning work includes Amber City (1999), Lost Book Found (1996), Instrument (1999) with the band Fugazi and Buried in Light (1995).  He works in video as well as 16mm and 8mm.  A blurring of the distinctions between documentary, narrative and experimental genres marks his work.  Cohen frequently shoots in hundreds of locations, without any additional crew, in the tradition of documentary street photographers such as Robert Frank.  His projects include collaborations with poets, writers and bands such as R.E.M and the Butthole Surfers, creating alternatives to generic and commodified 'music video'.  His films have been shown extensively at festivals in the United States and Europe.  Buried In Light was featured in ACMI's Remembrance and the Moving Image exhibition in 2003 and Chain Times Three featured in PROOF 2004.\n\nTaken from PROOF 2004 (SW)\n\nWorks:\n\nWitness Butthole Surfers, 1986, super 8/video, 12:00 mins\n\nThis Is A History of New York, 1988, super 8/video, 23:00 min\n\nJust Hold Still, 1989, super 8/video, 35:00 min\n\nWhat Does \"Away\" Mean? 1990, 30:00 min\n\nDrink Deep, 1991, super 8/video, 9:00 min\n\nBlack Hole Radio, 1992, super 8/video, 7:00 min\n\nEarly Works, 1988 - 1992, super 8/video, 77:00 min\n\nBuried in Light (Central and Eastern Europe in Passing), 1994, super 8/video, 60:00 min\n\nLost Book Found, 1996, 8/16mm/video, 37:00 min\n\nLucky 3 (a portrait of Elliott Smith), 1997, 16mm/video, 11:00 min\n\nAmber City, 1999, 48:00 min\n\nInstrument, 1999, 1:55:00 min", "biography_author": null, "date_of_biography": "2023-05-09T12:47:57.498845+10:00", "external_links": [], "uuid": "83555660-820a-4c74-a31d-c1ce384908fb", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "110660", "external_references": [], "date_modified": "2023-06-14T16:33:30.576250+10:00"}]}