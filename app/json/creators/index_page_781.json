{"count": 28689, "next": "https://api.acmi.net.au/creators/?page=782", "previous": "https://api.acmi.net.au/creators/?page=780", "results": [{"id": 77775, "name": "Arthur Lubin", "roles_in_work": [{"id": 2474918, "title": "High flyers", "work_id": 88515, "role": "director", "role_id": 938, "is_primary": true}, {"id": 1988943, "title": "The Phantom of the opera", "work_id": 84977, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1898-07-25", "date_of_death": "1995-05-12", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 1, "name": "English", "slug": "english"}], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Arthur Lubin (July 25, 1898 – May 11, 1995) was an American film director and producer who directed several Abbott & Costello films, Phantom of the Opera (1943), the Francis the Talking Mule series and created the talking-horse TV series Mister Ed. A prominent director for Universal Pictures in the 1940s and 1950s, he is perhaps best known today as the man who gave Clint Eastwood his first contract in film.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T17:47:25.789437+10:00", "external_links": [{"id": 3594, "uri": "https://en.wikipedia.org/wiki/Arthur_Lubin"}], "uuid": "3fd0ffcf-c1b6-4d96-9448-e3811aa8f1c7", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "15548", "external_references": [{"id": 26407, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q327493"}, {"id": 27372, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "21228946"}, {"id": 27373, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n88100729"}, {"id": 27374, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n88100729"}], "date_modified": "2023-09-05T17:47:28.490726+10:00"}, {"id": 77774, "name": "Fred Wilcox", "role