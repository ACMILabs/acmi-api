1, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T13:05:02.974180+10:00", "external_links": [], "uuid": "cd507a60-e2bf-4ba9-b51f-9d0f4c436267", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "10158", "external_references": [{"id": 36989, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q121160066"}], "date_modified": "2023-09-05T22:13:13.172691+10:00"}, {"id": 34078, "name": "Pal Gabor", "roles_in_work": [{"id": 811527, "title": "Angi Vera", "work_id": 92472, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1932-11-02", "date_of_death": "1987-10-21", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [], "places_of_operation": [{"id": 25, "name": "Hungary", "slug": "hungary"}], "biography": "Pál Gábor (2 November 1932 – 21 October 1987) was a Hungarian film director and screenwriter. He directed 20 films between 1962 and 1987. In 1979, he was a member of the jury at the 29th Berlin International Film Festival.His most famous work was 1978's Angi Vera, about a woman in a re-education camp in post-war Hungary.  His films usually focused on the concerns of people in communist Hungary.\n\n", "biography_author": "Wikidata", "date_of_biography": "2022-05-19T12:37:57.513915+10:00", "external_links": [{"id": 2809, "uri": "https://en.wikipedia.org/wiki/P%C3%A1l_G%C3%A1bor"}], "uuid": "787a88a1-7201-42e5-8f50-70930fd7bda0", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "26032", "external_references": [{"id": 11974, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q571230"}, {"id": 11975, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "53168462"}, {"id": 11976, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n86059617"}, {"id": 11977, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n86059617"}], "date_modified": "2023-09-13T12:31:43.229565+10:00"}, {"id": 34077, "name": "Max Farberbock", "roles_in_work": [{"id": 2084045, "title": "Aimee & Jaguar = Aimee and Jaguar", "work_id": 92469, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1950-09-22", "date_of_death": null, "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 1, "name": "English", "slug": "english"}, {"id": 4, "name": "French", "slug": "french"}, {"id": 5, "name": "German", "slug": "german"}], "places_of_operation": [{"id": 18, "name": "Germany", "slug": "germany"}], "biography": "Max Färberböck (born 22 September 1950) is a German film director and writer. He was born in Brannenburg, Bavaria. He began his career at theaters in Buenos Aires and in Italy. He later studied at the University of Television and Film in Munich and worked for Constantin Film and as an assistant for Peter Zadek at the Deutsches Schauspielhaus in Hamburg. After producing several plays at theaters in Hamburg, Heidelberg and Cologne, he began to write and direct episodes for the TV series Der Fahnder. \nLater Färberböck produced several TV films, before making his first feature film, Aimée & Jaguar (1998). It was nominated for the Golden Globe Award for Best Foreign Language Film. The film was also nominated for the Golden Bear at 49th Berlin International Film Festival.He directed A Woman in Berlin (2008), based on the memoir by the same name. A new edition had been published in Germany in 2003, two years after the author's death. This controversial work dealt with the experiences of women in Berlin in the last weeks of the Battle of Berlin and occupation by Soviet Union troops at the end of World War II. The author is reputed to be the late journalist, Marta Hillers, who died in 2001.\n\n", "biography_author": "Wikidata", "date_of_biography": "2022-05-19T12:26:04.793897+10:00", "external_links": [{"id": 2679, "uri": "https://en.wikipedia.org/wiki/Max_F%C3%A4rberb%C3%B6ck"}], "uuid": "562aebab-71e1-4bdf-a757-c4516e31c956", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "24863", "external_references": [{"id": 11436, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q66070"}, {"id": 11437, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "56270970"}, {"id": 11438, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no2001095488"}, {"id": 11439, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no2001095488"}], "date_modified": "2023-09-13T12:31:20.381682+10:00"}, {"id": 34075, "name": "Senator Film Production", "roles_in_work": [{"id": 2084038, "title": "Aimee & Jaguar = Aimee and Jaguar", "work_id": 92469, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2347471, "title": "The Experiment = Das Experiment", "work_id": 95073, "role": "production company", "role_id": 941, "is_primary": true}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": "2023-05-09T19:49:51.493032+10:00", "external_links": [], "uuid": "d19219bf-d5a3-4ca9-a5e6-0c1a165dd8f1", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "12429", "external_references": [{"id": 40777, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q29390930"}], "date_modified": "2023-09-06T01:10:32.958096+10:00"}, {"id": 34074, "name": "Linda Reisman", "roles_in_work": [{"id": 1996383, "title": "Waking the dead", "work_id": 92669, "role": "co-producer", "role_id": 915, "is_primary": true}, {"id": 1996063, "title": "Affliction", "work_id": 92468, "role": "producer", "role_id": 1089, "is_primary": true}], "also_known_as": "", "date_of_birth": nu