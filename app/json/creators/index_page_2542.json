"places_of_operation": [], "biography": "Brian Doyle works in video, installation and photography, producing semi-fictionalised documentaries.  Since graduating with a Master of Fine Arts (MFA) from the School of the Art Institute of Chicago, Doyle has exhibited his work in galleries, museums, film festivals and on television throughout America and Europe.  He garnered the Special Jury Prize at the New York Underground Film Festival, 2002; Best Experimental Film from the Chicago Underground Film Festival, 2003; and a nomination for the Werkleitz Project Grant from the Kasseler Dokumentarfilm & Videofest, Kassel, 2003.  Doyle lives and works in New York.\n\n(SW 30.03.05)", "biography_author": null, "date_of_biography": "2023-08-14T11:18:55.169121+10:00", "external_links": [], "uuid": "fee89d8a-975a-4eab-bb4d-9acc34a16d01", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "2355", "external_references": [], "date_modified": "2023-08-14T11:18:55.169460+10:00"}, {"id": 10693, "name": "Advanced Diploma of Multimedia (ADoM), RMIT", "roles_in_work": [{"id": 1660738, "title": "Willow", "work_id": 110423, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 1660743, "title": "RMIT ADoM compilation 2005-2006", "work_id": 110418, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 1660742, "title": "Yue", "work_id": 110422, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 1660730, "title": "The City", "work_id": 110421, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 1660735, "title": "Dreaming", "work_id": 110417, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2396905, "title": "3000", "work_id": 111122, "role": "production facilities", "role_id": 442, "is_primary": false}, {"id": 1911982, "title": "Albe's Alphabet", "work_id": 109737, "role": "production location", "role_id": 514, "is_primary": false}], "also_known_as": "", "date_of_birt