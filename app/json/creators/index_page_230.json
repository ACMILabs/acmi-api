known_as": "", "date_of_birth": "1927-07-25", "date_of_death": "2003-03-27", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 4, "name": "French", "slug": "french"}], "places_of_operation": [{"id": 17, "name": "France", "slug": "france"}], "biography": "Daniel Ceccaldi (25 July 1927 – 27 March 2003) was a French actor.\nHe was born in Meaux, Seine-et-Marne, France. The mild-mannered Daniel Ceccaldi is famous as Claude Jade's father Lucien Darbon in François Truffaut's movies Stolen Kisses and Bed and Board. Note: Christine refers to him twice as \"Lucien\", not papa, indicating perhaps that he is not her biological father, echoing Truffaut's own experience. The American critic Bob Wade wrote about Ceccaldi in 'Stolen Kisses': \"Claude Jade's parents are memorably played by Daniel Ceccaldi and Claire Duhamel. Ceccaldi’s role may represent the most pleasant and neurosis-free father in any movie of the era. He overflows with Dickensian warmth and geniality.\"", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T18:50:49.735333+10:00", "external_links": [{"id": 3815, "uri": "https://en.wikipedia.org/wiki/Daniel_Ceccaldi"}], "uuid": "ad0e6bfd-ff3e-44aa-9301-f9369a727c35", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "31160", "external_references": [{"id": 26132, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q663802"}, {"id": 27979, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "5057558"}, {"id": 27980, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "no97010403"}, {"id": 27981, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-no97010403"}], "date_modified": "2023-09-05T18:50:49.745207+10:00"}, {"id": 83132, "name": "Marianne Khoury", "roles_in_work": [{"id": 2083960, "title": "Adieu Bonaparte = Al-Wedaa Ya Bonaparte", "work_id": 116078, "role": "producer", "role_id": 1089, "is_primary": true}], "also_known