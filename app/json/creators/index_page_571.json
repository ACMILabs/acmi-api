"title": "The Luzhin defence", "work_id": 92339, "role": "co-producer", "role_id": 915, "is_primary": true}], "also_known_as": "", "date_of_birth": null, "date_of_death": null, "genders": [], "languages": [], "places_of_operation": [], "biography": "", "biography_author": null, "date_of_biography": null, "external_links": [], "uuid": "ed82c699-96ca-4b09-a300-4b5c24bd17c4", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": null, "external_references": [{"id": 41421, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q121036321"}], "date_modified": "2023-09-05T18:21:17.061367+10:00"}, {"id": 79769, "name": "Christopher Guest", "roles_in_work": [{"id": 2113440, "title": "Best in show", "work_id": 92481, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2113459, "title": "Best in show", "work_id": 93286, "role": "director", "role_id": 938, "is_primary": true}, {"id": 1995820, "title": "Waiting for Guffman", "work_id": 92338, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "1948-02-05", "date_of_death": "", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 1, "name": "English", "slug": "english"}], "places_of_operation": [{"id": 1, "name": "United States of America", "slug": "united-states-of-america"}], "biography": "Christopher Haden-Guest, 5th Baron Haden-Guest (born 5 February 1948), known professionally as Christopher Guest, is an American-British screenwriter, composer, musician, director, actor, and comedian. Guest is most widely known in Hollywood for having written, directed, and starred in his series of comedy films shot in mockumentary style. Many scenes and character backgrounds in Guest's films are written and directed, although actors have no rehearsal time and the ensemble improvises scenes while filming them. The series of films began with This Is Spinal Tap (which he did not direct) and continued with Waiting for Guffman, Best in Show, A Mighty Wind,  For Your Consideration, and Mascots.\nGuest holds a hereditary British peerage as the 5th Baron Haden-Guest, and has publicly expressed a desire to see the House of Lords reformed as a democratically elected chamber. Though he was initially active in the Lords, his career there was cut short by the House of Lords Act 1999, which removed the right of most hereditary peers to a seat in the parliament. When using his title, he is normally styled as Lord Haden-Guest. Guest is married to the actress and author Jamie Lee Curtis.\n\n", "biography_author": "Wikidata", "date_of_biography": "2023-08-01T14:26:57.838368+10:00", "external_links": [{"id": 1821, "uri": "https://en.wikipedia.org/wiki/Christopher_Guest"}], "uuid": "c80e2f29-a19c-4321-b60c-67577acebb63", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "16959", "external_references": [{"id": 7922, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q336074"}, {"id": 7923, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "66668009"}, {"id": 7924, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n91079290"}, {"id": 7925, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n91079290"}], "date_modified": "2023-09-05T18:36:04.241282+10:00"}]}