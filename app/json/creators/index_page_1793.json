rk_id": 85873, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2293150, "title": "Torment = L' Enfer", "work_id": 86863, "role": "director", "role_id": 938, "is_primary": true}, {"id": 811227, "title": "The Butcher = Le Boucher", "work_id": 92397, "role": "director", "role_id": 938, "is_primary": true}, {"id": 804404, "title": "The Darling does = Les Biches [Widescreen]", "work_id": 90048, "role": "director", "role_id": 938, "is_primary": true}, {"id": 1997860, "title": "The Unfaithful wife = La Femme infidele [Widescreen]", "work_id": 93508, "role": "director", "role_id": 938, "is_primary": true}, {"id": 1998014, "title": "La Ceremonie", "work_id": 93584, "role": "director", "role_id": 938, "is_primary": true}, {"id": 1997847, "title": "Madame Bovary [DVD]", "work_id": 93504, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2560035, "title": "2+2=4", "work_id": 116447, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2559693, "title": "A double tour = Web of passion", "work_id": 116240, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2559690, "title": "Les Bonnes Femmes = the Good Girls", "work_id": 116239, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2559405, "title": "Le Beau Serge = Handsome Serge", "work_id": 116088, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2559335, "title": "La Femme Infidele = the Unfaithful Wife", "work_id": 116058, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2559294, "title": "L'oeil du Malin = the Third Lover", "work_id": 116036, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2559038, "title": "Les Cousins = the Cousins", "work_id": 115912, "role": "director", "role_id": 938, "is_primary": true}, {"id": 889499, "title": "Les Noces rouges = Blood wedding", "work_id": 115705, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2558955, "title": "Le Cheval D'orgueil = the Horse of Pride", "work_id": 115875, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2558920, "title": "Poulet Au Vinaigre = Cop Au Vin", "work_id": 115860, "role": "director", "role_id": 938, "is_primary": true}, {"id": 889432, "title": "La Rupture = The Breakup", "work_id": 115680, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2301641, "title": "Six in Paris = Paris vu par ...", "work_id": 83029, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2558969, "title": "Le Signe du Lion = the Sign of Leo", "work_id": 115883, "role": "producer", "role_id": 1089, "is_primary": true}, {"id": 815809, "title": "The Cousins = Les Cousins", "work_id": 93510, "role": "producer/director", "role_id": 31, "is_primary": true}, {"id": 1997862, "title": "Handsome Serge = Le Beau Serge", "work_id": 93509, "role": "producer/director", "role_id": 31, "is_primary": true}], "also_known_as": "Claude Henri Jean Chabrol", "date_of_birth": "1930-06-24", "date_of_death": "2010-09-12", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 1, "name": "English", "slug": "english"}, {"id": 4, "name": "French", "slug": "french"}, {"id": 5, "name": "German", "slug": "german"}], "places_of_operation": [{"id": 17, "name": "France", "slug": "france"}], "biography": "Claude Henri Jean Chabrol (French: [klod ʃabʁɔl]; 24 June 1930 – 12 September 2010) was a French film director and a member of the French New Wave (nouvelle vague) group of filmmakers who first came to prominence at the end of the 1950s. Like his colleagues and contemporaries Jean-Luc Godard, François Truffaut, Éric Rohmer and Jacques Rivette, Chabrol was a critic for the influential film magazine Cahiers du cinéma before beginning his career as a film maker.\nChabrol's career began with Le Beau Serge (1958), inspired by Hitchcock's Shadow of a Doubt (1943). Thrillers became something of a trademark for Chabrol, with an approach characterized by a distanced objectivity. This is especially apparent in Les Biches (1968), La Femme infidèle (1969), and Le Boucher (1970) – all featuring Stéphane Audran, who was his wife at the time.\nSometimes characterized as a \"mainstream\" New Wave director, Chabrol remained prolific and popular throughout his half-century career. In 1978, he cast Isabelle Huppert as the lead in Violette Nozière. On the strength of that effort, the pair went on to others including the successful Madame Bovary (1991) and La Cérémonie (1995). Film critic John Russell Taylor has stated that \"there are few directors whose films are more difficult to explain or evoke on paper, if only because so much of the overall effect turns on Chabrol's sheer hedonistic relish for the medium...Some of his films become almost private jokes, made to amuse himself.\" James Monaco has called Chabrol \"the craftsman par excellence of the New Wave, and his variations upon a theme give us an understanding of the explicitness and precision of the language of the film that we don't get from the more varied experiments in genre of Truffaut or Godard.\"", "biography_author": "Wikidata", "date_of_biography": "2022-05-19T11:06:51.189871+10:00", "external_links": [{"id": 1834, "uri": "https://en.wikipedia.org/wiki/Claude_Chabrol"}], "uuid": "a3082d5c-6ac8-41bd-9078-f75507684a6e", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "17064", "external_references": [{"id": 7970, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q55375"}, {"id": 7971, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "84192392"}, {"id": 7972, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n50035844"}, {"id": 7973, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n50035844"}], "date_modified": "2024-10-18T23:06:09.420044+11:00"}, {"id": 25142, "name": "Jean Douchet", "roles_in_work": [{"id": 2559039, "title": "Paris Vu Par = Six in Paris", "work_id": 115913, "role": "director", "role_id": 938, "is_primary": true}, {"id": 2301632, "title": "Six in Paris = Paris vu par ...", "work_id": 83029, "role": "director", "role_id": 938, "is_primary": true}], "also_known_as": "", "date_of_birth": "19 JAN 1929", "date_of_death": "22 NOV 2019", "genders": [{"id": 9, "name": "Male", "slug": "male"}], "languages": [{"id": 4, "name": "French", "slug": "french"}], "places_of_operation": [{"id": 17, "name": "France", "slug": "france"}], "biography": "Jean Douchet (French: [duʃɛ]; 19 January 1929 – 22 November 2019) was a French film director, historian, film critic and teacher who began his career in the early 1950s at Gazette du Cinéma and Cahiers du cinéma with members of the future French New Wave. Source: Wikidata; 01/08/2023", "biography_author": null, "date_of_biography": "2024-10-18T22:40:28.618087+11:00", "external_links": [{"id": 4295, "uri": "https://en.wikipedia.org/wiki/Jean_Douchet"}], "uuid": "ec4492f5-6199-41a6-aaf4-ff2b3a7db9e2", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "31046", "external_references": [{"id": 25558, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q918681"}, {"id": 29285, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "54345654"}, {"id": 29286, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n88631744"}, {"id": 29287, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n88631744"}], "date_modified": "2024-10-18T22:40:28.618321+11:00"}, {"id": 25138, "name": "American Playhouse Theatrical Films", "roles_in_work": [{"id": 2214278, "title": "Eat a bowl of tea", "work_id": 83025, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2178294, "title": "Daughters of the dust [Widescreen]", "work_id": 90539, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 794119, "title": "The North = El Norte", "work_id": 86808, "role": "production company", "role_id": 941, "is_pr