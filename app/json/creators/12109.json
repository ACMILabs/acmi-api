"work_id": 72973, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2609747, "title": "Soils and foundations", "work_id": 72972, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2609528, "title": "Science and sheep breeding", "work_id": 72524, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2609414, "title": "Remodelling milk", "work_id": 72136, "role": "production company", "role_id": 941, "is_primary": true}, {"id": 2610456, "title": "The Unknown ocean", "work_id": 74219, "role": "sponsor", "role_id": 625, "is_primary": false}], "also_known_as": "", "date_of_birth": "", "date_of_death": "", "genders": [], "languages": [], "places_of_operation": [], "biography": "The Commonwealth Scientific and Industrial Research Organisation (CSIRO) is an Australian Government agency responsible for scientific research.\nCSIRO works with leading organisations around the world. From its headquarters in Canberra, CSIRO maintains more than 50 sites across Australia and in France, Chile and the United States, employing about 5,500 people.\nFederally funded scientific research in Australia began in 1916; the Advisory Council of Science and Industry was established in that year, but was hampered by insufficient available finance. In 1926, the research effort was reinvigorated by establishment of the Council for Scientific and Industrial Research (CSIR), which strengthened national science leadership and increased research funding. CSIR grew rapidly and achieved significant early successes. In 1949, further legislated changes included renaming the organisation as CSIRO.Notable developments by CSIRO have included the invention of atomic absorption spectroscopy, essential components of the early Wi-Fi technology, development of the first commercially successful polymer banknote, the invention of the insect repellent in Aerogard and the introduction of a series of biological controls into Australia, such as the introduction of myxomatosis and rabbit calicivirus for the control of rabbit populations.", "biography_author": "Wikidata", "date_of_biography": "2023-09-05T18:47:15.475094+10:00", "external_links": [{"id": 5762, "uri": "https://en.wikipedia.org/wiki/CSIRO"}], "uuid": "06ead0b0-4ea0-451c-9891-2b7303d606a3", "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "110557", "external_references": [{"id": 39735, "source": {"name": "Wikidata", "slug": "wikidata"}, "source_identifier": "Q1117048"}, {"id": 54240, "source": {"name": "VIAF", "slug": "viaf"}, "source_identifier": "315073228"}, {"id": 54241, "source": {"name": "LOC Auth", "slug": "loc-auth"}, "source_identifier": "n90704975"}, {"id": 54242, "source": {"name": "WorldCat", "slug": "worldcat"}, "source_identifier": "lccn-n90704975"}], "date_modified": "2025-02-26T20:27:53.629846+11:00"}