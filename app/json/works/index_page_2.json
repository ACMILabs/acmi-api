_for_label": "", "headline_credit_for_label": "<p>United States, 1981</p>", "description": "", "description_for_label": [], "credit_line_for_label": "", "details": [{"label": "Curatorial section", "display_values": ["The Story of the Moving Image&nbsp;→ Moving Australia&nbsp;→ MA-02. New Wave&nbsp;→ MA-02-C01"]}, {"label": "Measurements", "display_values": ["280 x 210 x 10mm (closed)"]}, {"label": "Object Types", "display_values": ["Journal/Magazine/Newsletter/Textual"]}], "stats": {"tap_count": 0}, "links": [], "creators_primary": [], "creators_other": [], "media_note": "Sorry, we don't have images or video for this item.", "holdings": [], "part_of": null, "parts": [], "part_siblings": [], "group": {"id": 125417, "acmi_id": "198888", "title": "The Devil's Playground", "title_annotation": "", "slug": "the-devils-playground-1976", "creator_credit": "", "credit_line": "", "headline_credit": "Australia, 1976", "video_links": [], "record_type": "group", "type": "Object", "is_on_display": true, "last_on_display_place": "ACMI: Gallery 1", "last_on_display_date": "2028-11-12", "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": true, "first_production_date": "1976-01-01T11:00:00+11:00", "commissioned": false, "public_domain": false, "external_references": []}, "group_works": [], "group_siblings": [], "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "198312", "eaas_environment_id": null, "production_places": [{"id": 2, "name": "United States", "slug": "united-states"}], "production_dates": [{"date": "1981", "notes": "", "to_year": "1981"}], "labels": [64878]}, {"id": 125416, "acmi_id": "199102", "title": "Immersive Sound in Cinema", "title_annotation": "", "slug": "immersive-sound-in-cinema", "creator_credit": "", "credit_line": "", "headline_credit": "", "video_links": [], "record_type": "group", "type": "Film", "is_on_display": false, "last_on_display_place": null, "last_on_display_date": null, "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": false, "first_production_date": null, "commissioned": false, "public_domain": false, "external_references": [], "brief_description": "<p>When Star Wars hit cinemas in the late 1970s and 80s, sound engineer Tomlinson Holman noticed a problem: the rich, detailed audio created during production wasn’t being heard properly in theatres. His solution was THX – a new sound standard that ensured films played exactly as filmmakers intended.<br />\nWhen Return of the Jedi (1983) premiered, only THX-certified cinemas could show it. Audiences were greeted by the now-iconic ‘Deep Note’ – a rising wave of tones swelling into a mighty D major chord. It shook the room and set the stage for the galaxy far, far away – as well as a new level of excellence in cinema sound.<br />\nFun fact: THX was named after George Lucas’s first film, THX 1138 (1971).</p>", "constellations_primary": [], "constellations_other": [], "recommendations": [], "title_for_label": "<p>Immersive Sound in Cinema</p>", "creator_credit_for_label": "", "headline_credit_for_label": "", "description": "<p>When Star Wars hit cinemas in the late 1970s and 80s, sound engineer Tomlinson Holman noticed a problem: the rich, detailed audio created during production wasn’t being heard properly in theatres. His solution was THX – a new sound standard that ensured films played exactly as filmmakers intended.<br />\nWhen Return of the Jedi (1983) premiered, only THX-certified cinemas could show it. Audiences were greeted by the now-iconic ‘Deep Note’ – a rising wave of tones swelling into a mighty D major chord. It shook the room and set the stage for the galaxy far, far away – as well as a new level of excellence in cinema sound.<br />\nFun fact: THX was named after George Lucas’s first film, THX 1138 (1971).</p>", "description_for_label": ["<p>When Star Wars hit cinemas in the late 1970s and 80s, sound engineer Tomlinson Holman noticed a problem: the rich, detailed audio created during production wasn’t being heard properly in theatres. His solution was THX – a new sound standard that ensured films played exactly as filmmakers intended.<br />\nWhen Return of the Jedi (1983) premiered, only THX-certified cinemas could show it. Audiences were greeted by the now-iconic ‘Deep Note’ – a rising wave of tones swelling into a mighty D major chord. It shook the room and set the stage for the galaxy far, far away – as well as a new level of excellence in cinema sound.<br />\nFun fact: THX was named after George Lucas’s first film, THX 1138 (1971).</p>"], "credit_line_for_label": "", "details": [{"label": "Curatorial section", "display_values": ["The Story of the Moving Image&nbsp;→ Moving Pictures&nbsp;→ MI-05. Sound and Colour&nbsp;→ MI-05-C02"]}], "stats": {"tap_count": 0}, "links": [], "creators_primary": [], "creators_other": [], "media_note": "Sorry, we don't have images or video for this item.", "holdings": [], "part_of": null, "parts": [], "part_siblings": [], "group": null, "group_works": [], "group_siblings": [], "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "199102", "eaas_environment_id": null, "production_places": [], "production_dates": [], "labels": [64876]}, {"id": 125415, "acmi_id": "199151", "title": "Isopod", "title_annotation": "", "slug": "isopod", "creator_credit": "Sbug games", "credit_line": "<p>Isopod (2025) transforms you into a tiny pill-bug navigating a huge Australian bush. You roll, zip, and slam through colourful leaves, twigs, and moss, using magnetic physics to stick, repel, and bounce. Team up with other bugs to solve puzzles, smash through obstacles, and outsmart dangerous fire-ants. Along the way, you uncover the rhythms of the ecosystem, watching plants grow, insects scuttle, and animals interact. The game blends playful, kinetic platforming with a gentle, immersive lesson in nature, showing how even the smallest creatures can make a big impact in their world.</p>", "headline_credit": "Australia, 2025", "video_links": [], "record_type": "group", "type": "Object", "is_on_display": false, "last_on_display_place": null, "last_on_display_date": null, "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": false, "first_production_date": "2025-01-01T11:00:00+11:00", "commissioned": false, "public_domain": false, "external_references": [], "brief_description": "", "constellations_primary": [], "constellations_other": [], "recommendations": [], "title_for_label": "<p>Isopod</p>", "creator_credit_for_label": "<p>Sbug games</p>", "headline_credit_for_label": "<p>Australia, 2025</p>", "description": "", "description_for_label": [], "credit_line_for_label": "<p>Isopod (2025) transforms you into a tiny pill-bug navigating a huge Australian bush. You roll, zip, and slam through colourful leaves, twigs, and moss, using magnetic physics to stick, repel, and bounce. Team up with other bugs to solve puzzles, smash through obstacles, and outsmart dangerous fire-ants. Along the way, you uncover the rhythms of the ecosystem, watching plants grow, insects scuttle, and animals interact. The game blends playful, kinetic platforming with a gentle, immersive lesson in nature, showing how even the smallest creatures can make a big impact in their world.</p>", "details": [{"label": "Object Types", "display_values": ["Group"]}], "stats": {"tap_count": 0}, "links": [], "creators_primary": [{"id": 3109037, "name": "Sbug games", "creator_id": 87385, "creator_wikidata_id": null, "role": "developer", "role_id": 658, "is_primary": true}], "creators_other": [], "media_note": "Sorry, we don't have images or video for this item.", "holdings": [], "part_of": null, "parts": [], "part_siblings": [], "group": null, "group_works": [], "group_siblings": [], "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "199151", "eaas_environment_id": null, "production_places": [{"id": 3, "name": "Australia", "slug": "australia"}], "production_dates": [{"date": "2025", "notes": "", "to_year": "2025"}], "labels": [64875]}, {"id": 125411, "acmi_id": "199100", "title": "Immersive sound in cinema", "title_annotation": "", "slug": "immersive-sound-in-cinema", "creator_credit": "", "credit_line": "", "headline_credit": "", "video_links": [], "record_type": "group", "type": "Film", "is_on_display": false, "last_on_display_place": "ACMI: Gallery 1", "last_on_display_date": "2028-12-22", "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": false, "first_production_date": null, "commissioned": false, "public_domain": false, "external_references": [], "brief_description": "<p>By the early 1950s, television was keeping people at home, and cinemas needed to offer something special. Sound became key to creating an experience that couldn’t be matched in the living room.<br />\nIn 1952, This Is Cinerama wowed New York audiences with a huge curved screen and a new multi-channel sound system developed by Hazard E Reeves. Instead of a single speaker, Cinerama used seven – five behind the screen and two behind the audience – wrapping viewers in sound.<br />\nThis early form of surround sound transformed movie-going, setting the stage for the immersive audio experiences we expect in cinemas today.</p>", "constellations_primary": [{"id": 426, "name": "Immersive sound: from THX to surround (a placeholder)", "description": "The THX sound became a symbol of immersive cinema, signalling pristine audio quality. From Return of the Jedi to videogames, creators explored spatial sound, dynamic mixing, and atmospheric audio, showing how sound shapes experience, emotion, and perception across multiple media forms."}], "constellations_other": [], "recommendations": [], "title_for_label": "<p>Immersive sound in cinema</p>", "creator_credit_for_label": "", "headline_credit_for_label": "", "description": "<p>By the early 1950s, television was keeping people at home, and cinemas 