nks": [], "record_type": "work", "type": "Object", "is_on_display": true, "last_on_display_place": "ACMI", "last_on_display_date": "2031-02-16", "is_context_indigenous": false, "material_description": "Digital film camera", "unpublished": false, "external": false, "first_production_date": null, "commissioned": false, "public_domain": false, "external_references": [], "brief_description": "<p>The Blackmagic URSA Cine 17K 65 brings large-format 65mm filmmaking within reach of more creators. Traditionally associated with epic cinema, 65mm refers to a larger image area than standard 35mm film, allowing for greater detail, depth and scale. Here, that cinematic format is reimagined as a digital camera system.</p>\n<p>The 17K sensor captures images with extraordinary resolution, suitable for giant IMAX-style screens or cropped for cinema and television formats. Just as significant is its integrated production workflow. With fast, high-capacity storage built into the camera and high-speed networking for on-set media sync, it can record small proxy files alongside original media and share footage with editors while shooting continues.</p>\n<p>This camera was used to shoot HBO’s Rooster (2026), starring Steve Carell, and reflects Blackmagic Design’s ambition to make high-end production more seamless and accessible.</p>", "constellations_primary": [], "constellations_other": [], "recommendations": [], "creator_credit_for_label": "<p>Blackmagic Design</p>", "creator_credit_for_label_zh_hans": "", "creator_credit_for_label_pa": "", "creator_credit_for_label_hi": "", "headline_credit_for_label": "<p>Melbourne, Victoria, Australia</p>", "headline_credit_for_label_zh_hans": "", "headline_credit_for_label_pa": "", "headline_credit_for_label_hi": "", "title_for_label_zh_hans": "", "title_for_label_pa": "", "title_for_label_hi": "", "title_for_label_override_zh_hans": "", "title_for_label_override_pa": "", "title_for_label_override_hi": "", "description_for_label_zh_hans": "", "descri