isplay_date": null, "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": false, "first_production_date": "1988-01-01T11:00:00+11:00", "commissioned": false}, {"id": 80265, "acmi_id": "324272", "title": "Using Word Perfect 5.0", "title_annotation": "", "slug": "using-word-perfect-50", "creator_credit": "", "credit_line": "", "headline_credit": "United States, 1988", "video_links": [], "record_type": "work", "type": "Film", "is_on_display": false, "last_on_display_place": null, "last_on_display_date": null, "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": false, "first_production_date": "1988-01-01T11:00:00+11:00", "commissioned": false}], "group_siblings": [], "source": {"name": "Vernon", "slug": "vernon"}, "source_identifier": "58347", "eaas_environment_id": null, "production_places": [{"id": 2, "name": "United States", "slug": "united-states"}], "production_dates": [{"date": "1988", "notes": "Produced", "to_year": "1988"}], "labels": [54663], "external_references": []}, {"id": 118033, "acmi_id": "", "title": "Videogames supercut", "title_annotation": "", "slug": "videogames-supercut", "creator_credit": "ACMI", "credit_line": "", "headline_credit": "Australia, 2020", "video_links": [], "record_type": "work", "type": "Film", "is_on_display": true, "last_on_display_place": "ACMI: Gallery 1", "last_on_display_date": "2031-02-16", "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": false, "first_production_date": "2020-01-01T11:00:00+11:00", "commissioned": false, "brief_description": "<p>Today’s videogames focus as much on emotion as they do action. Through evolving technical expertise and the power of narrative, character and story are now as vital to a memorable gaming experience as ammo clips and power-ups.</p>", "constellations_primary": [{"id": 276, "name": "Action, emotion and videogames", "description": "More and more, videogames are beginning to favour emotion as much as action, just like their film and TV cousins."}], "constellations_other": [], "recommendations": [], "title_for_label": "<p>Videogames supercut</p>", "creator_credit_for_label": "<p>ACMI</p>", "headline_credit_for_label": "<p>Australia, 2020</p>", "description": "<p>Today’s videogames focus as much on emotion as they do action. Through evolving technical expertise and the power of narrative, character and story are now as vital to a memorable gaming experience as ammo clips and power-ups. This video interweaves scenes from AAA, indie games and everything in-between to explore the emotional impact of games, as well as the white-knuckle tension of battle, how time can be manipulated for dramatic effect and how artistic expressions like movement and dance are bringing a human element to gaming.</p>", "description_for_label": ["<p>Today’s videogames focus as much on emotion as they do action. Through evolving technical expertise and the power of narrative, character and story are now as vital to a memorable gaming experience as ammo clips and power-ups. This video interweaves scenes from AAA, indie games and everything in-between to explore the emotional impact of games, as well as the white-knuckle tension of battle, how time can be manipulated for dramatic effect and how artistic expressions like movement and dance are bringing a human element to gaming.</p>"], "credit_line_for_label": "", "details": [{"label": "Curatorial section", "display_values": ["The Story of the Moving Image&nbsp;→ Games Lab"]}, {"label": "Object Types", "display_values": ["Moving image file/Digital"]}], "stats": {"tap_count": 86924}, "links": [], "creators_primary": [{"id": 1728381, "name": "ACMI", "creator_id": 6272, "creator_wikidata_id": null, "role": "creator", "role_id": 968, "is_primary": true}], "creators_other": [], "media_note": null, "holdings": [], "part_of": null, "parts": [], "part_siblings": [], "group": null, "group_works": [], "group_siblings