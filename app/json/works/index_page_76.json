ns": "", "title_pa": "", "title_hi": "", "title_annotation": "", "title_annotation_zh_hans": "", "title_annotation_pa": "", "title_annotation_hi": "", "slug": "caulfield-a-living-city", "creator_credit": "John Freney-Mills, Ewart Wade, Caulfield City Council and Caulfield Film Society", "credit_line": "", "credit_line_zh_hans": "", "credit_line_pa": "", "credit_line_hi": "", "headline_credit": "Australia, 1963", "video_links": [{"id": 562, "name": "ACMI External Digital Access Copy", "uri": "https://youtu.be/EIS-XNUWFZY"}], "record_type": "work", "type": "Film", "is_on_display": false, "last_on_display_place": "ACMI Viewing Booths", "last_on_display_date": "2019-04-22", "is_context_indigenous": false, "material_description": "", "unpublished": false, "external": false, "first_production_date": "1963-01-01T10:00:00+10:00", "commissioned": false, "public_domain": false, "external_references": [], "brief_description": "<p>Weekend activities in the City of Caulfield. Schools, churches, sporting and social service groups keep the city alive at weekends. Activities include the running of the Caulfield Cup, and quieter games such as tennis and bowls. School children learn road safety at special classes and attend the Youth Centre. For the elderly citizens there are &#8220;meals-on-wheels&#8221;.</p>\n<p>(11/2/19 CC) Selected highlights list from MP:<br />\n00:00:02:00 Title card with Caulfield Town Hall in background<br />\n00:00:32:00 Caulfield train station<br />\n00:01:07:00 Caulfield Race Course on Caulfield Cup<br />\n00:01:54:00 Caulfield marching girls perform with Caulfield Citizen band<br />\n00:03:54:00 Packer Reserve Bike Track with St Johns Ambulance attendees<br />\n00:04:35:00 Caulfield Park Bowling Club with men playing bowls and women playing croquet at 00:04:56:00<br />\n00:05:20:00 Caulfield Central RSL<br />\n00:05:50:00 cricket game on H.G Ritchie Oval<br />\n00:06:12:00 15th Caulfield Somers Country scouts packing glass bottles into a 1950&#8217;s Holden Ute<br />\n00:06:40:00 model aeroplane flying with Caulfield Technical College - now Monash University (Caulfield campus) in background<br />\n00:07:02:00 City of Caulfield Memorial Youth Centre with basketball being played and wrestling with up and coming star Don Fitzpatrick<br />\n00:08:00:00 Women sewing at the Caulfield Memorial Youth Centre<br />\n00:08:38:00 Curraweena homes near Caulfield community hall<br />\n00:09:55:00 Salvation Army marches past Salvation Army building<br />\n00:10:20:00 Church service at St Catharine South Caulfield, 402 Kooyong Rd<br />\n00:11:07:00 Salvation Army band play at Nooralie Private Hospital<br />\n00:12:24:00 what appears to be St Aloysius Church with spire<br />\n00:12:44:00 Caulfield Park Conservatory and gardens<br />\n00:14:00:00 garbage collection from house and people leaving for work<br />\n00:14:52:00 shot of Caulfield Technical College now Monash University (Caulfield campus) and students entering the front stair case<br />\n00:15:05:00 Kilyington Baptist Grammar School<br />\n00:15:30:00 Caulfield South Pre-school<br />\n00:15:52:00 Elsternwick train station<br />\n00:16:08:00 asphalt laying<br />\n00:16:28:00 Sir Henry Gullett Memorial Baby Health Centre<br />\n00:16:43:00 Elderly Citizen Club and meals service<br />\n00:18:27:00 Caulfield Town Hall inside and outside</p>", "constellations_primary": [], "constellations_other": [], "recommendations": [], "creator_credit_for_label": "<p>John Freney-Mills, Ewart Wade, Caulfield City Council and Caulfield Film Society</p>", "creator_credit_for_label_zh_hans": "", "creator_credit_for_label_pa": "", "creator_credit_for_label_hi": "", "headline_credit_for_label": "<p>Australia, 1963</p>", "headline_credit_for_label_zh_hans": "", "headline_credit_for_label_pa": "", "headline_credit_for_label_hi": "", "title_for_label_zh_hans": "", "title_for_label_pa": "", "title_for_label_hi": "", "title_for_label_override_zh_hans": "", "title_for_label_override_pa": "", "title_for_l